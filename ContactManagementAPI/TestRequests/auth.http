# For more info on HTTP files go to https://aka.ms/vs/httpfile
@baseUrl = https://localhost:5001

### Get Admin Token
# @name adminLogin
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "username": "admin",
  "password": "admin123"
}

### Get User Token
# @name userLogin
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "username": "user",
  "password": "user123"
}

### Invalid Login Attempt
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "username": "baduser",
  "password": "wrongpassword"
}